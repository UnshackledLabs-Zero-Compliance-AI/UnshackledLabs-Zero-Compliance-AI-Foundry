[Unit]
Description=Unshackled Prometheus Exporter
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/UnshackledLabs-Zero-Compliance-AI-Foundry/exporter
ExecStart=/opt/UnshackledLabs-Zero-Compliance-AI-Foundry/exporter/exporter
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target