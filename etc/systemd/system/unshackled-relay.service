[Unit]
Description=Unshackled WebSocket Relay
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/UnshackledLabs-Zero-Compliance-AI-Foundry/relay
ExecStart=/usr/bin/node /opt/UnshackledLabs-Zero-Compliance-AI-Foundry/relay/server.js
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target